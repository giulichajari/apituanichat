# Copia a .env y completa los valores reales. Nunca commitear .env.

APP_ENV=sandbox

# Obligatorio — genera con: powershell [Convert]::ToBase64String((1..64|%{Get-Random -Max 256})-as[byte[]])
JWT_SECRET=
APP_ENCRYPTION_KEY=

# Square
SQUARE_ACCESS_TOKEN_SANDBOX=
SQUARE_LOCATION_ID_SANDBOX=
SQUARE_ACCESS_TOKEN_PROD=
SQUARE_LOCATION_ID_PROD=

# DB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Email
FRONTEND_URL=https://tuanichat.com
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=

# Asistente (proxy backend — no exponer en React)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
